{
  "installCommand": "npm install --prefix client --include=dev",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/db-status",
      "destination": "/api/db-status.js"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/mentor/:match*",
      "destination": "/api/mentor.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
